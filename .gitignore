# ============================================
#  Репозиторий — это сама тема promix.
#  Клонируется в wp-content/themes/promix.
#  Ядро WordPress, плагины и загрузки живут
#  локально и на сервере, но не в git.
# ============================================

# --- Секреты ---
**/wp-config.php
.env
.env.local

# --- Всё, что не тема, живёт в docs/ и в git не идёт:
#     docs/client — документы заказчика, docs/data — выгрузки из 1С
#     и собранные CSV для импорта, docs/reports — отчёты и ревью.
#     Маски ниже — страховка, если файл положили не туда ---
docs/
*.pdf
*.docx
REPORT-*.md
REVIEW-*.md

# --- IDE ---
.idea/
.vscode/

# --- ОС ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Архивы и временное ---
*.zip
*.rar
*.7z
*.sql
*.sql.gz
*.tmp
*.bak
*~

# --- Node, если появится сборка ассетов ---
node_modules/
dist/

# --- Выгрузки из 1С и прочие таблицы (их место — docs/data) ---
*.xls
*.xlsx
*.csv

# --- Carbon Fields ставится composer'ом, vendor коммитим:
#     на хостинге composer может быть недоступен ---
vendor/**/node_modules/
vendor/**/.git/
