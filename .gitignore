# ============================================
#  Репозиторий — это сама тема promix.
#  Клонируется в wp-content/themes/promix.
#  Ядро WordPress, плагины и загрузки живут
#  локально и на сервере, но не в git.
# ============================================

# --- Секреты ---
**/wp-config.php
.env
.env.local

# --- Клиентские документы и черновики ---
docs/

# --- IDE ---
.idea/
.vscode/

# --- ОС ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Архивы и временное ---
*.zip
*.rar
*.7z
*.sql
*.sql.gz
*.tmp
*.bak
*~

# --- Node, если появится сборка ассетов ---
node_modules/
dist/

# --- Выгрузки из 1С и прочие таблицы: не в репозиторий темы ---
*.xls
*.xlsx
*.csv

# --- Carbon Fields ставится composer'ом, vendor коммитим:
#     на хостинге composer может быть недоступен ---
vendor/**/node_modules/
vendor/**/.git/
